{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",

        "NEXT_PUBLIC_FUNNEL_URL",
        "NEXT_PUBLIC_PWA_URL",

        "SOLIDGATE_ENVIRONMENT",
        "SOLIDGATE_API_PUBLIC_KEY",
        "SOLIDGATE_API_SECRET_KEY",
        "SOLIDGATE_WEBHOOK_PUBLIC_KEY",
        "SOLIDGATE_WEBHOOK_SECRET_KEY",

        "PAYMENT_COOKIE_SECRET",
        "ENABLED_CHECKOUT_LOCALES",

        "INTERNAL_API_SECRET",
        "CRON_SECRET",

        "ADMIN_EMAILS",
        "ADMIN_FX_RATES",

        "RESEND_API_KEY",
        "RESEND_FROM_ADDRESS",

        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_META_PIXEL_ID",
        "META_PIXEL_ID",
        "META_CAPI_ACCESS_TOKEN",
        "META_CAPI_TEST_EVENT_CODE",
        "NEXT_PUBLIC_GTM_ID",

        "ACTIVECAMPAIGN_API_URL",
        "ACTIVECAMPAIGN_API_KEY",
        "AC_INTERNAL_SECRET",

        "NEXT_PUBLIC_ENABLE_DEV_LOGIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
