# ─────────────────────────────────────────────────────────────────────────────
# Funnel + PWA Boilerplate — master environment reference
# ─────────────────────────────────────────────────────────────────────────────
# This file documents EVERY variable the boilerplate reads, with the scope that
# reads it and whether it is required. It is a reference, not a runtime file.
#
# At runtime each app reads its own file:
#   apps/funnel/.env.local   (see apps/funnel/.env.example)
#   apps/pwa/.env.local      (see apps/pwa/.env.example)
#
# The repo-root scripts (scripts/*.ts) dotenv-load apps/funnel/.env.local.
#
# Never commit a real .env.local — .gitignore already excludes it.
#
# Legend:  [required]  must be set or the surface fails
#          [optional]  feature degrades gracefully when unset
#          [platform]  injected by the host (Vercel/Supabase) — do NOT set by hand
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────────────
# [required] funnel + pwa + scripts
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
# [required] funnel + pwa (browser-safe, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# [required] server-side only: funnel, pwa, Edge Functions, scripts. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# [platform] Edge Functions only — injected by the Supabase runtime.
# SUPABASE_URL=
# [optional] scripts only. Direct Postgres connection (operator role).
# Must use TLS and point at the same project as the anon URL above.
# SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres?sslmode=require


# ── App URLs ─────────────────────────────────────────────────────────────────
# [required] funnel + pwa + Edge Function. No trailing slash.
NEXT_PUBLIC_FUNNEL_URL=http://localhost:3205
NEXT_PUBLIC_PWA_URL=http://localhost:3206


# ── Solidgate ────────────────────────────────────────────────────────────────
# Sandbox and live are SEPARATE CHANNELS with separate key pairs on the same
# hosts. There is no test-mode flag — which environment you hit is decided
# purely by which channel's keys are present.
#
#   api_* pair  → signs API calls and the encrypted payment-form intent
#   wh_*  pair  → verifies inbound webhook signatures
#
# Use `production` ONLY in the Vercel Production scope. Preview must be `sandbox`.
#
# [required] funnel + pwa + scripts
SOLIDGATE_ENVIRONMENT=sandbox
SOLIDGATE_API_PUBLIC_KEY=api_pk_replace_me
SOLIDGATE_API_SECRET_KEY=api_sk_replace_me
# [required] Supabase Edge Function (solidgate-webhooks)
SOLIDGATE_WEBHOOK_PUBLIC_KEY=wh_pk_replace_me
SOLIDGATE_WEBHOOK_SECRET_KEY=wh_sk_replace_me
# [optional] funnel cron: override if the function has a different name.
# Defaults to NEXT_PUBLIC_SUPABASE_URL/functions/v1/solidgate-webhooks.
# The endpoint rejects a runtime environment mismatch before replaying events.
# SOLIDGATE_WEBHOOK_RECOVERY_URL=https://your-project.supabase.co/functions/v1/solidgate-webhooks
# [optional] sandbox webhook channel, if you run a second Edge Function for it.
# SOLIDGATE_WEBHOOK_PUBLIC_KEY_SANDBOX=
# SOLIDGATE_WEBHOOK_SECRET_KEY_SANDBOX=
# [optional] Let the sandbox webhook drain cancellation work against a specific
# Vercel Preview deployment. The secret must equal that preview's
# INTERNAL_API_SECRET. Leave empty to disable. NEVER point this at production.
# SOLIDGATE_SANDBOX_FULFILLMENT_URL=https://preview.example.com/api/internal/solidgate-fulfillment
# SOLIDGATE_SANDBOX_FULFILLMENT_SECRET=
#
# NOTE: Solidgate product and price IDs are NOT environment variables. They are
# generated by `npx tsx scripts/solidgate-seed-catalog.ts --apply` and committed
# to packages/shared/src/solidgate/catalog-ids.json. See docs/new-product-checklist.md.


# ── Payments / session ───────────────────────────────────────────────────────
# [required] funnel. Signs the payment session cookie. Use >=32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_COOKIE_SECRET=replace_with_at_least_32_random_bytes
# [optional] funnel. Comma-separated locales the checkout is enabled for.
ENABLED_CHECKOUT_LOCALES=en


# ── Internal / cron auth ─────────────────────────────────────────────────────
# [required] funnel AND pwa. Shared secret for internal service-to-service routes.
INTERNAL_API_SECRET=replace_with_a_random_internal_secret
# [required] wherever vercel.json declares crons[]. Vercel sends it as
# `Authorization: Bearer <value>` and manages the value for you in production.
CRON_SECRET=replace_with_a_random_cron_secret


# ── Admin dashboard (funnel /admin) ──────────────────────────────────────────
# [required] to reach the admin dashboard at all. Comma-separated, lowercased on read.
ADMIN_EMAILS=admin@example.com
# [optional] Static currency->EUR multipliers for unified revenue display.
# Format: comma-separated CODE:RATE. Missing currencies fall back to 1.0 + a warning.
ADMIN_FX_RATES=USD:0.92


# ── Email (Resend) ───────────────────────────────────────────────────────────
# [required] funnel (also read by pwa)
RESEND_API_KEY=re_replace_me
# [required] funnel. Must be a sender you have verified in Resend.
RESEND_FROM_ADDRESS="Acme <hello@example.com>"


# ── Analytics ────────────────────────────────────────────────────────────────
# All optional — each integration no-ops when its key is absent.
# [optional] both apps
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# [optional] funnel, browser pixel
NEXT_PUBLIC_META_PIXEL_ID=replace_me
# [optional] funnel, server-side Conversions API. Falls back to the public id.
META_PIXEL_ID=replace_me
# Generate in Events Manager -> Pixel -> Settings -> Conversions API.
META_CAPI_ACCESS_TOKEN=replace_me
# [optional] set ONLY while validating in Events Manager -> Test Events.
META_CAPI_TEST_EVENT_CODE=
# [optional] funnel
NEXT_PUBLIC_GTM_ID=GTM-REPLACE_ME


# ── CRM / marketing automation (optional) ────────────────────────────────────
# ACTIVECAMPAIGN_API_URL=https://your-account.api-us1.com
# ACTIVECAMPAIGN_API_KEY=replace_me
# AC_INTERNAL_SECRET=replace_with_a_random_secret


# ── Ops (optional) ───────────────────────────────────────────────────────────
# Edge Function posts chargeback/dispute notifications here.
# SLACK_DISPUTE_WEBHOOK_URL=


# ── Local development only ───────────────────────────────────────────────────
# [optional] pwa. Sign in at /login with any email and no OTP code.
# Hard-disabled whenever NODE_ENV=production, so it is safe to document here.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true


# ── Platform-injected — never set these by hand ──────────────────────────────
# VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV, NODE_ENV
