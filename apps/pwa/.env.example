# PWA member area (port 3206) — copy to apps/pwa/.env.local and fill in.
# Full reference for every variable: ../../.env.example

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FUNNEL_URL=http://localhost:3205
NEXT_PUBLIC_PWA_URL=http://localhost:3206

# ── Solidgate (in-app purchases, upsells, card updates) ──────────────────────
# Server-only: the browser receives server-built merchantData, never keys.
SOLIDGATE_ENVIRONMENT=sandbox
SOLIDGATE_API_PUBLIC_KEY=api_pk_replace_me
SOLIDGATE_API_SECRET_KEY=api_sk_replace_me

# ── Internal / cron auth ─────────────────────────────────────────────────────
# Required: the internal and cron route handlers authenticate on this.
INTERNAL_API_SECRET=replace_with_a_random_internal_secret
# Only needed if apps/pwa/vercel.json declares crons[].
CRON_SECRET=replace_with_a_random_cron_secret

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── In-app upsell ────────────────────────────────────────────────────────────
# Auto-opens the paywall sheet on the member's 2nd and 5th app-open (see
# TrialPromoGate). Unset = the paywall only ever opens from an explicit tap.
# NEXT_PUBLIC_TRIAL_PROMO_ENABLED=true

# ── Local development only ───────────────────────────────────────────────────
# Sign in at /login with any email and no OTP code. Leave UNSET to use the real
# 6-digit OTP flow everywhere, including `next dev`. Hard-disabled whenever
# NODE_ENV=production, so it is safe to leave documented here.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
#
# Prefills the /login email field when the dev shortcut above is on.
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=dev@example.com
#
# Lets /api/user-prefs and /api/app-open resolve a seeded account when there is
# no Supabase session. Ignored entirely when NODE_ENV=production.
# DEV_FALLBACK_EMAIL=dev@example.com
