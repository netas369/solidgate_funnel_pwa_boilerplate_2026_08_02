# CRO dashboard (port 3207) — copy to apps/cro/.env.local and fill in.
# Full reference for every variable: ../../.env.example

# ── Supabase ─────────────────────────────────────────────────────────────────
# These are the ONLY two variables this app reads, and that is deliberate.
#
# There is NO SUPABASE_SERVICE_ROLE_KEY here and there must never be one.
# Every read goes through a cro_* SECURITY DEFINER function that checks the
# caller against public.cro_analysts, so the service-role key would buy nothing
# and would turn an internal report into a full-database credential sitting on
# a public hostname. src/lib/no-service-role.test.ts fails the build if the
# string ever appears in this app's source.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_or_hosted_anon_key

# ── Who can log in ───────────────────────────────────────────────────────────
# Nobody, until you add them — there is no env allowlist:
#
#   INSERT INTO public.cro_analysts (email, note)
#   VALUES ('you@example.com', 'added by <name> on <date>');
#
# Revoking is a DELETE and takes effect on that person's next page load.
