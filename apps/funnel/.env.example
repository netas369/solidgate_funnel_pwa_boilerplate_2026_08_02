# Funnel app (port 3205) — copy to apps/funnel/.env.local and fill in.
# Keep real credentials in Vercel / Supabase secrets, never in this file.
# The repo-root scripts/*.ts also dotenv-load THIS file's .env.local.
# Full reference for every variable: ../../.env.example

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_or_hosted_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FUNNEL_URL=http://localhost:3205
NEXT_PUBLIC_PWA_URL=http://localhost:3206

# ── Quiz session ─────────────────────────────────────────────────────────────
# Keep this different from the Payment cookie secret.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SESSION_COOKIE_SECRET=replace_with_a_different_32_byte_random_value
# Optional A/B assignment, e.g. control-v1:50,treatment-v1:50.
# FUNNEL_VARIANT_WEIGHTS=
# FUNNEL_EXPERIMENT_KEY=funnel-v1

# ── Payments ─────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_COOKIE_SECRET=replace_with_at_least_32_random_bytes

# Sandbox and live are separate Solidgate channels with separate key pairs.
# Configure live values ONLY in the Vercel Production scope.
SOLIDGATE_ENVIRONMENT=sandbox
SOLIDGATE_API_PUBLIC_KEY=api_pk_replace_me
SOLIDGATE_API_SECRET_KEY=api_sk_replace_me
# Needed here only if you run the webhook verification locally; the deployed
# webhook lives in the Supabase Edge Function and reads its own secrets.
SOLIDGATE_WEBHOOK_PUBLIC_KEY=wh_pk_replace_me
SOLIDGATE_WEBHOOK_SECRET_KEY=wh_sk_replace_me

# Comma-separated locales the checkout is enabled for.
ENABLED_CHECKOUT_LOCALES=en

# ── CRO definition publisher (optional) ─────────────────────────────────────
# Grouping labels stamped on the published quiz definition, read only by
# `npx tsx scripts/publish-quiz-definition.ts`. They let one CRO dashboard tell
# several apps (and several funnel families within an app) apart.
# CRO_APP_KEY=boilerplate
# CRO_FUNNEL_KEY=main


# ── Internal / cron auth ─────────────────────────────────────────────────────
INTERNAL_API_SECRET=replace_with_a_random_internal_secret

# Where this product's CRO board lives. Read by /api/internal/cro-login-link to
# build the one-time link that opens it already signed in, so PMC Hub can hand
# an analyst straight through. Without it that endpoint 500s; nothing else in
# this app needs it.
NEXT_PUBLIC_CRO_URL=http://localhost:3207
# Vercel sends this as `Authorization: Bearer <value>` to scheduled jobs.
CRON_SECRET=replace_with_a_random_cron_secret

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me
RESEND_FROM_ADDRESS="Acme <hello@example.com>"

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Required — the dashboard is unreachable until at least one email is listed.
ADMIN_EMAILS=admin@example.com
# Optional. Comma-separated CODE:RATE multipliers to EUR for revenue display.
ADMIN_FX_RATES=USD:0.92

# ── Analytics (all optional; each no-ops when unset) ─────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_META_PIXEL_ID=replace_me
META_PIXEL_ID=replace_me
META_CAPI_ACCESS_TOKEN=replace_me
# Set only while validating events in Meta Events Manager.
META_CAPI_TEST_EVENT_CODE=
NEXT_PUBLIC_GTM_ID=GTM-REPLACE_ME

# ── CRM / marketing automation (optional) ────────────────────────────────────
# ACTIVECAMPAIGN_API_URL=https://replace-me.api-us1.com
# ACTIVECAMPAIGN_API_KEY=replace_me
# AC_INTERNAL_SECRET=replace_with_a_random_secret
